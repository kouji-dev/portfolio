# Authoring tooling that lives in the repo but must never be served from the
# domain root. The static site (index.html, styles.css, cosmos.js, cv/*.pdf)
# ships as before.

# CV pipeline: YAML sources, generator scripts, node deps.
# The PDFs it writes into cv/ ARE deployed — the sources behind them are not.
cv-source/

# Claude Code skills + the kouji job-hunt plugin.
.claude/
kouji/

# E2E tooling — never served.
e2e/
node_modules/
playwright.config.js
package.json
package-lock.json
test-results/
playwright-report/

# Design source + data/tooling scripts — never served.
design/
scripts/
pnpm-lock.yaml

# Working notes (performance work lists) — never served.
docs/
